{
  "name": "pypao",
  "displayName": "PyPao",
  "description": "Python/IPython utilities including run file in console, start IPython, copy imports, and clean __pycache__. Mimics PyCharm's 'Run File in Python Console' using the VS Code Python extension's selected interpreter/venv.",
  "version": "0.1.0",
  "publisher": "local-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/ieachen/vscode-python-pypao"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "logo.png",
  "categories": [
    "Other"
  ],
  "keywords": [
    "python",
    "ipython",
    "venv",
    "virtualenv",
    "console",
    "pycharm",
    "copyImport"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pyPao.createIpython",
        "title": "New \"ipython\" terminal"
      },
      {
        "command": "pyPao.createIpythonMatplotlib",
        "title": "New \"ipython --matplotlib\" terminal"
      },
      {
        "command": "pyPao.runPython",
        "title": "\"python\" run file"
      },
      {
        "command": "pyPao.runIpython",
        "title": "\"ipython\" run file"
      },
      {
        "command": "pyPao.run",
        "title": "\"ipython -i\" run file"
      },
      {
        "command": "pyPao.runMatplotlib",
        "title": "\"ipython -i --matplotlib\" run file"
      },
      {
        "command": "pyPao.copyImport",
        "title": "Copy import"
      },
      {
        "command": "pyPao.deletePycache",
        "title": "List and delete __pycache__"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "pyPao",
          "when": "resourceLangId == python",
          "group": "navigation@0"
        }
      ],
      "pyPao": [
        {
          "command": "pyPao.createIpython",
          "group": "1_session@1"
        },
        {
          "command": "pyPao.createIpythonMatplotlib",
          "group": "1_session@2"
        },
        {
          "command": "pyPao.runPython",
          "group": "2_run@1"
        },
        {
          "command": "pyPao.runIpython",
          "group": "2_run@2"
        },
        {
          "command": "pyPao.run",
          "group": "2_run@3"
        },
        {
          "command": "pyPao.runMatplotlib",
          "group": "2_run@4"
        },
        {
          "command": "pyPao.copyImport",
          "group": "3_utils@1"
        },
        {
          "command": "pyPao.deletePycache",
          "group": "3_utils@2"
        }
      ],
      "commandPalette": [
        {
          "command": "pyPao.createIpython",
          "when": "resourceLangId == python"
        },
        {
          "command": "pyPao.createIpythonMatplotlib",
          "when": "resourceLangId == python"
        },
        {
          "command": "pyPao.runPython",
          "when": "resourceLangId == python"
        },
        {
          "command": "pyPao.runIpython",
          "when": "resourceLangId == python"
        },
        {
          "command": "pyPao.run",
          "when": "resourceLangId == python"
        },
        {
          "command": "pyPao.runMatplotlib",
          "when": "resourceLangId == python"
        },
        {
          "command": "pyPao.copyImport",
          "when": "resourceLangId == python"
        },
        {
          "command": "pyPao.deletePycache"
        }
      ]
    },
    "submenus": [
      {
        "id": "pyPao",
        "label": "PyPao"
      }
    ]
  },
  "extensionDependencies": [],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
